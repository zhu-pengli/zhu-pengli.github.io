---
layout: default
---
<div class="post home-page">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero__content">
      {% if page.hero.eyebrow %}
        <p class="home-hero__eyebrow">{{ page.hero.eyebrow }}</p>
      {% endif %}
      <h1 id="home-title" class="home-hero__title">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      {% if page.hero.tagline %}
        <p class="home-hero__tagline">{{ page.hero.tagline }}</p>
      {% endif %}
      {% if page.hero.summary %}
        <p class="home-hero__summary">{{ page.hero.summary }}</p>
      {% endif %}

      {% if page.hero.topics %}
        <ul class="home-hero__topics" aria-label="Research topics">
          {% for topic in page.hero.topics %}
            <li>{{ topic }}</li>
          {% endfor %}
        </ul>
      {% endif %}

    </div>

    {% if page.profile.image %}
      <div class="home-hero__portrait">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {% capture sizes %}(min-width: 992px) 300px, (min-width: 576px) 34vw, calc(100vw - 48px){% endcapture %}
        {%
          include figure.liquid
          loading="eager"
          path=profile_image_path
          class="img-fluid rounded"
          sizes=sizes
          alt="Portrait of Pengli Zhu"
          cache_bust=true
        %}
      </div>
    {% endif %}
  </section>

  <article class="home-content">
    <div class="clearfix">{{ content }}</div>

    {% if page.announcements and page.announcements.enabled %}
      <section class="home-news" aria-labelledby="news-title">
        <div class="home-section-heading">
          <h2 id="news-title">News</h2>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">Latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
